# 后端环境变量模板 —— 复制为 .env 并填入真实值,切勿把真实值提交到仓库
# 生产环境实际由 docker-compose 的 environment 段注入(值来自 admin/.env)

# ===== 数据库(DB_PASSWORD 必填) =====
DB_HOST=10.5.80.8
DB_PORT=3306
DB_USER=2ketang_app
DB_PASSWORD=<在此填数据库密码>
DB_NAME=2ketang

# ===== 应用 =====
TEST_MODE=False
DEBUG=False

# ===== JWT(SECRET_KEY 必填,用长随机串) =====
SECRET_KEY=<在此填长随机字符串,例如 openssl rand -hex 32 的输出>

# ===== 邮箱(QQ 邮箱授权码) =====
SENDER_EMAIL=<发件邮箱地址>
EMAIL_AUTH_CODE=<QQ邮箱SMTP授权码>

# ===== 第二课堂爬虫登录 =====
KETANG_USERNAME=<爬虫账号>
KETANG_PASSWORD=<爬虫密码>

# ===== 微信小程序 =====
WECHAT_APPID=<小程序AppID>
WECHAT_SECRET=<小程序AppSecret>
WECHAT_MINIPROGRAM_STATE=developer
WECHAT_TMPL_SIGN_IN=<订阅消息模板ID>
